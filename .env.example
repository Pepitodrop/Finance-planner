# Public application URL used for CORS and OAuth redirects.
# Production must use HTTPS, for example: https://finance.example.com
APP_ORIGIN=http://localhost:8080
WEB_PORT=8080
CONNECTOR_PORT=8787

# Local development may use local authentication. Public production must use a
# configured non-local authentication mode and set PUBLIC_DEPLOYMENT=true.
AUTH_MODE=local
PUBLIC_DEPLOYMENT=false

# Generate both values independently and store them in a secrets manager.
# Never commit real values or reuse either key.
# Example: openssl rand -hex 32
SESSION_SECRET=replace-with-at-least-32-random-characters
CONNECTOR_MASTER_KEY=replace-with-a-separate-random-master-key

# PostgreSQL is the Compose persistence backend. Use a strong, unique password.
POSTGRES_DB=finance_planner
POSTGRES_USER=finance_planner
POSTGRES_PASSWORD=replace-with-a-strong-database-password
DATABASE_POOL_SIZE=10

# Request protection and graceful shutdown. Tune only after load testing.
RATE_LIMIT_PER_MINUTE=120
SENSITIVE_RATE_LIMIT_PER_MINUTE=20
REQUEST_TIMEOUT_MS=15000
HEADERS_TIMEOUT_MS=10000
KEEP_ALIVE_TIMEOUT_MS=5000
SHUTDOWN_TIMEOUT_MS=10000

# Optional live providers.
GOCARDLESS_SECRET_ID=
GOCARDLESS_SECRET_KEY=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENVIRONMENT=sandbox
