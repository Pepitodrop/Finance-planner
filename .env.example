# Public application URL used for CORS and OAuth redirects.
APP_ORIGIN=http://localhost:8080
WEB_PORT=8080
CONNECTOR_PORT=8787
AUTH_MODE=local

# Generate both values independently. Do not reuse them.
# Example: openssl rand -hex 32
SESSION_SECRET=replace-with-at-least-32-random-characters
CONNECTOR_MASTER_KEY=replace-with-a-separate-random-master-key

# Optional live providers.
GOCARDLESS_SECRET_ID=
GOCARDLESS_SECRET_KEY=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENVIRONMENT=sandbox
