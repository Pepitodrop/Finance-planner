# Public application URL used for CORS and OAuth redirects.
# Production must use HTTPS, for example: https://finance.example.com
APP_ORIGIN=http://localhost:8080
WEB_PORT=8080
CONNECTOR_PORT=8787

# Local development may use local authentication. Public production must use a
# configured non-local authentication mode and set PUBLIC_DEPLOYMENT=true.
AUTH_MODE=local
PUBLIC_DEPLOYMENT=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional Google subscription/account-data connector. Google does not expose
# every Play or Store subscription through one universal API; unsupported items
# must use the manual fallback and must never be scraped from account pages.
GOOGLE_SUBSCRIPTIONS_ENABLED=false
GOOGLE_SUBSCRIPTIONS_SCOPES=openid email profile
GOOGLE_SUBSCRIPTIONS_DATA_SOURCE=

# WebAuthn/passkey relying-party values. Production RP ID must be the exact
# registrable application domain and APP_ORIGIN must be HTTPS.
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=Finance Planner

# Generate all values independently and store them in a secrets manager.
# Never commit real values or reuse keys.
# Example: openssl rand -hex 32
SESSION_SECRET=replace-with-at-least-32-random-characters
CONNECTOR_MASTER_KEY=replace-with-a-separate-random-master-key
AUTH_MASTER_KEY=replace-with-a-third-random-auth-encryption-key
METRICS_TOKEN=replace-with-a-fourth-random-metrics-token

# PostgreSQL is the canonical production persistence backend for authenticated
# finance state, auth profiles/passkeys, provider connections, webhooks, session
# revocation and distributed rate limits.
CONNECTOR_STORE_DRIVER=postgres
POSTGRES_DB=finance_planner
POSTGRES_USER=finance_planner
POSTGRES_PASSWORD=replace-with-a-strong-database-password
DATABASE_POOL_SIZE=10

# Release identity is included in readiness responses and Prometheus build info.
RELEASE_VERSION=0.2.0
RELEASE_SHA=replace-with-the-deployed-git-commit

# Hosted Hugging Face reasoning. The timeout remains below the browser-side
# 55-second guard while allowing model cold starts.
HF_TOKEN=
HF_TIMEOUT_MS=30000
HF_MODEL=Qwen/Qwen3-4B-Thinking-2507:fastest
HF_MODEL_REVISION=768f209d9ea81521153ed38c47d515654e938aea
HF_CRITIC_ENABLED=false
HF_CRITIC_MODEL=Qwen/Qwen3-4B-Instruct-2507:fastest
HF_CRITIC_MODEL_REVISION=1b4199c4f36b0cef378bfb12390c18780c18af4c

# Persistent learning-budget classification. Budget amounts and summaries stay
# deterministic; the model may only select reviewed qualitative emphasis enums.
HF_BUDGET_MODEL=Qwen/Qwen3-4B-Instruct-2507:fastest
HF_BUDGET_TIMEOUT_MS=30000

# Optional per-run coarse IP geolocation. The fixed HTTPS endpoint is ipwho.is;
# raw IP addresses are never persisted or forwarded to Hugging Face.
IP_GEOLOCATION_TIMEOUT_MS=4000

# Sustainable grocery-receipt review. The exact provider-routed model ID is
# allowlisted in server/src/receipt-intelligence.js. The :fastest route does not
# claim that Hugging Face served a particular immutable repository commit.
# Open weights are Apache-2.0; hosted inference quota or provider charges may apply.
HF_RECEIPT_MODEL=Qwen/Qwen2.5-VL-7B-Instruct:fastest
HF_RECEIPT_TIMEOUT_MS=45000

# Request protection, session revocation and graceful shutdown.
RATE_LIMIT_PER_MINUTE=120
SENSITIVE_RATE_LIMIT_PER_MINUTE=20
SESSION_REVOCATION_REFRESH_MS=30000
REQUEST_TIMEOUT_MS=15000
HEADERS_TIMEOUT_MS=10000
KEEP_ALIVE_TIMEOUT_MS=5000
SHUTDOWN_TIMEOUT_MS=10000

# Operational retention. Account finance data remains until explicit deletion;
# these limits apply to short-lived OAuth, webhook, rate-limit and revocation data.
RETENTION_INTERVAL_MS=21600000
WEBHOOK_RETENTION_DAYS=90
ABANDONED_WEBHOOK_RETENTION_DAYS=7
SESSION_REVOCATION_RETENTION_DAYS=400

# Optional live providers. Redirect URIs must exactly match APP_ORIGIN and the
# provider dashboard configuration. Tokens remain encrypted on the Node server.
PROVIDER_TIMEOUT_MS=15000
PROVIDER_RETRIES=2
GOCARDLESS_SECRET_ID=
GOCARDLESS_SECRET_KEY=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_SECRET=
PAYPAL_ENVIRONMENT=sandbox
