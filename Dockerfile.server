FROM node:22-bookworm-slim AS build
RUN apt-get update && apt-get install -y --no-install-recommends gnucobol && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY core/cobol/transaction_rules.cob core/cobol/transaction_rules.cob
COPY core/cobol/banking/banking-core.cob core/cobol/banking/banking-core.cob
COPY core/cobol/test-data-seed.cob core/cobol/test-data-seed.cob
RUN mkdir -p build \
    && cobc -Wall -Wextra -x -o build/transaction-rules core/cobol/transaction_rules.cob \
    && cobc -Wall -Wextra -x -o build/banking-core core/cobol/banking/banking-core.cob \
    && cobc -Wall -Wextra -x -o build/test-data-seed core/cobol/test-data-seed.cob

FROM node:22-bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends libcob4 ca-certificates dumb-init && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY server/package.json server/package-lock.json ./
RUN npm ci --omit=dev --no-fund --no-audit \
    && npm cache clean --force \
    && rm -rf /root/.npm \
              /usr/local/lib/node_modules/npm \
              /usr/local/lib/node_modules/corepack \
              /opt/yarn-* \
    && rm -f /usr/local/bin/npm \
             /usr/local/bin/npx \
             /usr/local/bin/corepack \
             /usr/local/bin/yarn \
             /usr/local/bin/yarnpkg
COPY server/src ./src
COPY server/scripts ./scripts
COPY server/migrations ./migrations
COPY --from=build /app/build/transaction-rules ./build/transaction-rules
COPY --from=build /app/build/banking-core ./build/banking-core
COPY --from=build /app/build/test-data-seed ./build/test-data-seed
RUN mkdir -p /app/data && chown -R node:node /app
USER node
ENV NODE_ENV=production \
    HOST=0.0.0.0 \
    PORT=8787 \
    COBOL_TRANSACTION_ENGINE=/app/build/transaction-rules \
    COBOL_BANKING_BINARY=/app/build/banking-core \
    COBOL_TEST_SEED_BINARY=/app/build/test-data-seed \
    COBOL_BANKING_REQUIRED=true \
    CONNECTOR_STORE_PATH=/app/data/connectors.enc.json \
    AUTH_STORE_PATH=/app/data/auth.enc.json
EXPOSE 8787
STOPSIGNAL SIGTERM
HEALTHCHECK --interval=30s --timeout=3s --start-period=10s --retries=3 CMD /app/build/banking-core normalize-account-type checking >/dev/null && node -e "fetch('http://127.0.0.1:8787/health/live').then(r=>{if(!r.ok)process.exit(1)}).catch(()=>process.exit(1))"
ENTRYPOINT ["dumb-init", "--"]
CMD ["node", "src/server.js"]
