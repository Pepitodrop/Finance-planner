{
  "id": "/",
  "name": "Finance Planner",
  "short_name": "Finance",
  "description": "Offline-first personal finance dashboard with local AI.",
  "start_url": "/?source=installed",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "minimal-ui"],
  "orientation": "any",
  "background_color": "#080c18",
  "theme_color": "#0b1020",
  "lang": "de-DE",
  "dir": "ltr",
  "categories": ["finance", "productivity"],
  "prefer_related_applications": false,
  "launch_handler": {
    "client_mode": ["navigate-existing", "auto"]
  },
  "shortcuts": [
    {
      "name": "Finanzübersicht öffnen",
      "short_name": "Übersicht",
      "description": "Öffnet die persönliche Finanzübersicht.",
      "url": "/?source=shortcut&view=dashboard"
    },
    {
      "name": "Transaktionen öffnen",
      "short_name": "Transaktionen",
      "description": "Öffnet die Buchungsliste.",
      "url": "/?source=shortcut&view=transactions"
    },
    {
      "name": "Finanzassistent öffnen",
      "short_name": "Assistent",
      "description": "Öffnet Analyse und Planung.",
      "url": "/?source=shortcut&view=assistant"
    }
  ],
  "icons": [
    {
      "src": "/icons/app-icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "/icons/app-icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "maskable"
    }
  ]
}
