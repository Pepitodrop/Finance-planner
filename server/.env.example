PORT=8787
APP_ORIGIN=http://localhost:5173
AUTH_MODE=local
SESSION_SECRET=replace-with-at-least-32-random-characters
CONNECTOR_MASTER_KEY=replace-with-at-least-32-random-characters
CONNECTOR_STORE_PATH=./data/connectors.enc.json

# GoCardless Bank Account Data
GOCARDLESS_SECRET_ID=
GOCARDLESS_SECRET_KEY=
# Optional operator override used ONLY when a start request carries no
# user-selected institutionId (e.g. an automated sandbox/runtime-verification
# run). It is validated against GoCardless's live institution directory just
# like a user selection -- it never silently overrides an explicit user pick,
# and it is rejected if it no longer matches a real institution.
GOCARDLESS_INSTITUTION_ID=

# PayPal Reporting API
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Optional for partner onboarding; owner-reporting mode works without it
PAYPAL_PARTNER_MERCHANT_ID=
