PORT=8787
APP_ORIGIN=http://localhost:5173
AUTH_MODE=local
SESSION_SECRET=replace-with-at-least-32-random-characters
CONNECTOR_MASTER_KEY=replace-with-at-least-32-random-characters
CONNECTOR_STORE_PATH=./data/connectors.enc.json

# Enable Banking (https://enablebanking.com) -- preferred AIS provider for
# normal bank connections; GoCardless remains available as fallback where
# Enable Banking is unconfigured or doesn't offer a given institution.
# Application id and RSA private key from the Enable Banking Control Panel.
# The private key signs a per-request RS256 application JWT server-side; it
# is never sent to the browser.
ENABLE_BANKING_APPLICATION_ID=
# Raw PEM contents. Prefer ENABLE_BANKING_PRIVATE_KEY_FILE in production --
# when both are set, the file takes precedence.
ENABLE_BANKING_PRIVATE_KEY=
# Path to a PEM file on disk. Takes precedence over ENABLE_BANKING_PRIVATE_KEY
# when set.
ENABLE_BANKING_PRIVATE_KEY_FILE=
# Informational only -- Enable Banking's REST API has a single base URL
# regardless of sandbox vs. production; that distinction lives in which
# application/key pair is registered in their Control Panel, not in a
# different endpoint.
ENABLE_BANKING_ENV=sandbox
# AIS consent duration Finance Planner requests, in days. Capped automatically
# to the selected ASPSP's own maximum_consent_validity when it's lower.
ENABLE_BANKING_CONSENT_DAYS=90

# GoCardless Bank Account Data
GOCARDLESS_SECRET_ID=
GOCARDLESS_SECRET_KEY=
# Optional operator override used ONLY when a start request carries no
# user-selected institutionId (e.g. an automated sandbox/runtime-verification
# run). It is validated against GoCardless's live institution directory just
# like a user selection -- it never silently overrides an explicit user pick,
# and it is rejected if it no longer matches a real institution.
GOCARDLESS_INSTITUTION_ID=

# PayPal Reporting API
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Optional for partner onboarding; owner-reporting mode works without it
PAYPAL_PARTNER_MERCHANT_ID=
